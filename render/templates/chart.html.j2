{#- Weekly check-off chart. Letter landscape, one page.
    Context: kid (profile dict), week (dict or None), rows (list), days (list of {key,label,date,mode}) -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Practice chart — {{ kid.id }}</title>
<style>
  @page { size: letter landscape; margin: 0.45in; }
  * { box-sizing: border-box; }
  body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #111; margin: 0; padding: 0; background: #fff; }
  .chart { padding: 0.3in; }
  header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8pt; }
  h1 { font-size: 20pt; margin: 0; }
  .week { font-size: 12pt; color: #444; }
  .week .fill { display: inline-block; min-width: 2.2in; border-bottom: 1.5px solid #333; }
  .name-fill { min-width: 1.8in; display: inline-block; border-bottom: 2px solid #333; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { border: 1.5px solid #333; text-align: center; vertical-align: middle; }
  th.area { width: 22%; }
  th.day { padding: 5pt 2pt; font-size: 12pt; }
  th.day small { display: block; font-weight: normal; color: #666; font-size: 8.5pt; }
  th.day.free { background: #f1f1f1; }
  th.day.free small { color: #333; font-weight: 600; }
  td.area { text-align: left; padding: 4pt 8pt; }
  td { height: 56pt; }
  .rows-few td { height: 74pt; }
  .rows-many td { height: 44pt; }
  .icon { font-size: 15pt; vertical-align: middle; margin-right: 8pt; }
  .label { font-size: 13pt; font-weight: 600; display: inline-block; vertical-align: middle; }
  .mins { display: block; font-size: 9pt; color: #555; font-weight: normal; }
  .mins .fill { display: inline-block; min-width: 0.5in; border-bottom: 1.5px solid #333; }
  .box { display: inline-block; width: 24pt; height: 24pt; border: 2px solid #111; border-radius: 4pt; }
  .icons .icon { font-size: 34pt; }
  .icons .label { font-size: 12pt; }
  .icons .box { width: 34pt; height: 34pt; }
  .cellmins { display: block; font-size: 8pt; color: #555; margin-top: 2pt; }
  .note { font-size: 9pt; color: #333; line-height: 1.2; padding: 0 2pt; }
  td.free { background: #f7f7f7; }
  tr.divider td { border-left: 0; border-right: 0; height: 7pt; background: #fff; }
  footer { display: flex; justify-content: space-between; margin-top: 8pt; font-size: 9pt; color: #555; }
  footer .rule { color: #333; }
</style>
</head>
<body>
<div class="chart {{ kid.chart.style }} {{ 'rows-few' if rows|length <= 5 else ('rows-many' if rows|length > 7 else '') }}">
<header>
  <h1>{% if kid.name and not kid.name.startswith('<') %}{{ kid.name }}'s{% else %}<span class="name-fill">&nbsp;</span>'s{% endif %} practice chart</h1>
  <div class="week">Week of
    {% if week %}{{ week.starts }} to {{ week.ends }}{% else %}<span class="fill"></span>{% endif %}
  </div>
</header>

<table>
  <thead>
    <tr>
      <th class="area"></th>
      {% for d in days %}
      <th class="day {{ d.mode }}">{{ d.label }}<small>{% if d.mode == 'free' %}free choice{% elif d.date %}{{ d.date }}{% else %}&nbsp;{% endif %}</small></th>
      {% endfor %}
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
    {% if row.outside_block and not loop.first and not rows[loop.index0 - 1].outside_block %}
    <tr class="divider"><td colspan="{{ days|length + 1 }}"></td></tr>
    {% endif %}
    <tr>
      <td class="area">
        <span class="icon">{{ row.icon }}</span><span class="label">{{ row.label }}
          <span class="mins">{% if row.minutes %}{{ row.minutes }} min{% else %}<span class="fill">&nbsp;</span> min{% endif %}{% if row.outside_block %} · after the block{% endif %}</span></span>
      </td>
      {% for d in days %}
        {% set cell = row.cells.get(d.key) %}
        <td class="{{ 'free' if d.mode == 'free' and not cell else '' }}">
          {% if cell and cell.external %}<span class="note">{{ cell.label }}</span>
          {% elif cell %}<span class="box"></span>{% if cell.minutes and cell.minutes != row.minutes %}<span class="cellmins">{{ cell.minutes }} min</span>{% endif %}
          {% endif %}
        </td>
      {% endfor %}
    </tr>
    {% endfor %}
  </tbody>
</table>

<footer>
  <span class="rule">{% if blank %}Write the minutes. Mark the days we'll do each one.{% else %}Done = the timer ran. Missed days don't carry over. Friday is free choice or nothing.{% endif %}</span>
  <span>rotation v{{ rotation_version }}</span>
</footer>
</div>
</body>
</html>
